{
    "rewrites": [
      {
        "source": "/api/:path*",
        "destination": "http://skunkworks.ignitesol.com:8000/:path*"
      }
    ],
    "headers": [
      {
        "source": "/api/:path*",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS" }
        ]
      }
    ]
  }